<h1> All Products </h1>

<table border="1" cellpadding="5">
    <tr>
        <th>Name</th>
        <th>Size</th>
        <th>Price</th>
        <th>Category</th>
    <tr>

    <% @products.each do |prod| %>
        <tr>
            <td><%= prod.name %></td>
            <td><%= prod.size %></td>
            <td><%= prod.price %></td>
            <td><%= prod.category&.name %></td>
        </tr>
    <% end %>
</table>